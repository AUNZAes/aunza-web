# Public values only: the site is plain files, so everything here is visible to visitors.
# Production values live in .env.production. Secrets go in the Worker's settings (see worker/forms.js).

# Public URL of the site, without trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Optional: public contact address shown on the Contact page and footer. Hidden when empty.
NEXT_PUBLIC_CONTACT_EMAIL=

# Address of the deployed forms Worker, without trailing slash.
NEXT_PUBLIC_FORMS_URL=
